# Anthropic credentials — pick ONE:
#   1) set ANTHROPIC_API_KEY here, or
#   2) run `ant auth login` once (the SDK picks up the profile automatically; leave this unset)
ANTHROPIC_API_KEY=

# Where the agent creates and builds projects (confined to this dir). Default: ./workspace
# WORKSPACE_DIR=C:\claude\generic\workspace

# Where the generator skills live (source of the widgets). Default: %USERPROFILE%\.claude\skills
# SKILLS_DIR=C:\Users\micha\.claude\skills

# Port. Default: 5178
# PORT=5178
